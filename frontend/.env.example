# Local Vite: leave empty to use the /api proxy in vite.config.ts
#   Frontend: http://localhost:5173
#   Proxy:    /api → http://127.0.0.1:5000
#
# Production build: use .env.production.example → VITE_API_URL=https://api.fti4iltes.tech
#
# Demo mode (no login): auto-ON during `npm run dev`.
# Force OFF even in dev: VITE_DEMO_MODE=false
# Force ON in a build:   VITE_DEMO_MODE=true

VITE_API_URL=
# VITE_DEMO_MODE=false
