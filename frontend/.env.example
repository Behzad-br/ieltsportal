# Local Vite: leave empty to use the /api proxy in vite.config.ts
#   Frontend: http://localhost:5173
#   Proxy:    /api → http://127.0.0.1:5000
#
# Production / staging: use .env.production.example → VITE_API_URL=https://api.fti4iltes.tech
#
# Demo sandbox (localStorage business data, demo-local-token):
#   OFF by default — staging/production must keep this false/unset.
#   Opt-in developer sandbox ONLY: VITE_DEMO_MODE=true
#   When on, UI shows "DEMO DATA — NOT PERSISTED".

VITE_API_URL=
VITE_DEMO_MODE=false
