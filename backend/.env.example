# Production template for /home/fti4success_admin/apps/itles-backend/.env
# Copy: cp .env.example .env  then set secrets manually on the VPS.
# Never commit real passwords or JWT values.
#
# Local monorepo: prefer repo-root `.env` (see ../.env.example).
# Local ports: backend http://127.0.0.1:5000 · frontend http://localhost:5173
# This project uses SQLAlchemy (SQLite / MySQL / PostgreSQL). There is no Supabase client.

NODE_ENV=production
ENV=production
# Prefer ENVIRONMENT for schema policy (development|test|staging|production).
ENVIRONMENT=production
# false in staging/production: Alembic owns schema (no create_all / silent ALTER).
AUTO_CREATE_SCHEMA=false
# Refuse startup when alembic current != head (default true in staging/production).
REQUIRE_MIGRATIONS_AT_HEAD=true
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=fti4success_admin_itles
DB_USER=fti4success_admin_itles_user
DB_PASSWORD=

# Optional override (if set to a full URL, it wins over DB_*):
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/fti4success_admin_itles?charset=utf8mb4
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Staging/production Postgres MUST include sslmode=require (app refuses otherwise).
# Never expose DATABASE_URL to the frontend / VITE_*.
DATABASE_URL=

DATA_DIR=/home/fti4success_admin/apps/itles-backend/data

FRONTEND_URL=https://fti4iltes.tech
CORS_ORIGINS=https://fti4iltes.tech,https://www.fti4iltes.tech

JWT_SECRET=
JWT_EXPIRE_HOURS=12
AUTH_LEGACY_HEADERS=false
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_EMAIL=admin@fti4iltes.tech
AUTH_BOOTSTRAP_NAME=Super Admin

LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_WRITING_GRADING_MODEL=gpt-4o-mini
OPENAI_WRITING_GENERATION_MODEL=gpt-4o-mini
WRITING_AI_GRADING_ENABLED=true
# Ops-only shared token for scripts. Leave empty in normal production.
# In production, token auth stays OFF unless ALLOW_WRITING_ADMIN_TOKEN=true.
WRITING_ADMIN_TOKEN=
ALLOW_WRITING_ADMIN_TOKEN=false

ENABLE_LIVE_MOCK_MONITORING=true
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

WHISPER_MODEL=base
DEFAULT_STUDENT_ID=local
