# Monorepo local/dev template — copy to repo root as `.env`
#   copy .env.example .env
# VPS API-only deploy: prefer backend/.env.example → backend/.env
# Never put real passwords or API keys in git.

NODE_ENV=development
ENV=development
PORT=5000

# ── Database (pick ONE approach) ─────────────────────────────────────────────
# A) Local SQLite (default when DATABASE_URL and DB_* are empty):
#    data/ielts_speaking.db under the project root
#
# B) Test PostgreSQL (Neon / local Postgres / similar — NOT Supabase in this repo):
#    DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#
# C) MySQL/MariaDB (production Hestia style):
#    DB_HOST=localhost
#    DB_PORT=3306
#    DB_NAME=...
#    DB_USER=...
#    DB_PASSWORD=...

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DATABASE_URL=

DATA_DIR=

# Frontend Vite runs on http://localhost:5173 (see frontend/vite.config.ts)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRE_HOURS=12
AUTH_LEGACY_HEADERS=false
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_EMAIL=admin@local
AUTH_BOOTSTRAP_NAME=Super Admin

LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_WRITING_GRADING_MODEL=gpt-4o-mini
OPENAI_WRITING_GENERATION_MODEL=gpt-4o-mini
WRITING_AI_GRADING_ENABLED=true
WRITING_ADMIN_TOKEN=

ENABLE_LIVE_MOCK_MONITORING=true
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

WHISPER_MODEL=base
DEFAULT_STUDENT_ID=local
